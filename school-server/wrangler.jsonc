{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "school-server",
  "main": "src/index.js",
  "compatibility_date": "2026-11-14",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "school-db",
      "database_id": "cf7d2a59-db76-418d-9267-6a5864dc4234"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://YOUR-STUDENT-SITE.pages.dev,https://YOUR-ADMIN-SITE.pages.dev"
  }
}
